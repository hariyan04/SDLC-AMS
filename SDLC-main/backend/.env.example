# ============================================================
# SDLC + AMS Intelligence - Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ---- REQUIRED -----------------------------------------------
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-strong-random-secret-here

# Supabase / PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- AI PROVIDERS (at least one required for AI mode) ------
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_MODEL=llama3

# ---- OPTIONAL -----------------------------------------------
PORT=3001
FRONTEND_URL=http://localhost:3000

# Ollama (local) - only needed if using Ollama provider
OLLAMA_URL=http://localhost:11434
